# syntax=docker/dockerfile:1.7

FROM debian:trixie-slim@sha256:4e401d95de7083948053197a9c3913343cd06b706bf15eb6a0c3ccd26f436a0e

ARG DEBIAN_FRONTEND=noninteractive

# Pinned server/tool versions verified from current upstream package metadata.
ARG NODE_VERSION=24.16.0
ARG CHROME_FOR_TESTING_VERSION=150.0.7871.24
ARG FILESYSTEM_SERVER_VERSION=2026.1.14
ARG GLOB_VERSION=13.0.6
ARG MEMORY_SERVER_VERSION=2026.1.26
ARG SEQUENTIAL_THINKING_SERVER_VERSION=2025.12.18
ARG CONTEXT7_SERVER_VERSION=3.2.1
ARG PLAYWRIGHT_MCP_VERSION=0.0.76
ARG PLAYWRIGHT_VERSION=1.61.0-alpha-1781023400000
ARG CHROME_DEVTOOLS_MCP_VERSION=1.3.0
ARG DBHUB_VERSION=0.22.3
ARG MCP_FETCH_VERSION=2026.6.4
ARG MCP_GIT_VERSION=2026.6.16
ARG MCP_TIME_VERSION=2026.6.4
ARG MARKITDOWN_MCP_VERSION=0.0.1a4
ARG SEMGREP_VERSION=1.167.0

ENV TZ=UTC \
    LANG=C.UTF-8 \
    LC_ALL=C.UTF-8 \
    SHELL=/bin/bash \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONPYCACHEPREFIX=/cache/python/pycache \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PIP_CACHE_DIR=/cache/pip \
    XDG_CACHE_HOME=/cache/xdg/cache \
    XDG_CONFIG_HOME=/cache/xdg/config \
    XDG_STATE_HOME=/cache/xdg/state \
    NPM_CONFIG_UPDATE_NOTIFIER=false \
    NPM_CONFIG_FUND=false \
    NPM_CONFIG_AUDIT=false \
    NPM_CONFIG_CACHE=/cache/npm \
    PLAYWRIGHT_BROWSERS_PATH=/cache/playwright/browsers \
    FETCH_IGNORE_ROBOTS_TXT=0 \
    SEMGREP_CACHE_DIR=/cache/semgrep \
    SEMGREP_SEND_METRICS=off \
    SEMGREP_ENABLE_VERSION_CHECK=0 \
    MEMORY_FILE_PATH=/cache/memory/memory.jsonl \
    DISABLE_THOUGHT_LOGGING=true \
    CHROME_DEVTOOLS_MCP_NO_USAGE_STATISTICS=1 \
    CHROME_DEVTOOLS_MCP_NO_UPDATE_CHECKS=1 \
    CHROME_PATH=/usr/local/bin/chrome-for-mcp \
    PUPPETEER_EXECUTABLE_PATH=/usr/local/bin/chrome-for-mcp \
    PATH=/opt/mcp-markdown-venv/bin:/opt/mcp-core-venv/bin:/opt/mcp-node/node_modules/.bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

SHELL ["/bin/bash", "-o", "pipefail", "-c"]

RUN cat > /etc/apt/apt.conf.d/99ci-mcp <<'EOF'
Acquire::Retries "5";
APT::Install-Recommends "0";
APT::Install-Suggests "0";
Dpkg::Use-Pty "0";
EOF

RUN apt-get update && \
    apt-get install --yes --no-install-recommends \
      bash \
      ca-certificates \
      chromium \
      curl \
      fonts-liberation \
      fonts-noto-color-emoji \
      git \
      jq \
      postgresql-client \
      python3 \
      python3-pip \
      python3-venv \
      sqlite3 \
      tini \
      unzip \
      xdg-utils \
      xz-utils && \
    rm -rf /var/lib/apt/lists/*

RUN arch="$(dpkg --print-architecture)" && \
    case "${arch}" in \
      amd64) node_arch=x64 ;; \
      arm64) node_arch=arm64 ;; \
      *) echo "Unsupported architecture for Node.js: ${arch}" >&2; exit 1 ;; \
    esac && \
    node_dist="node-v${NODE_VERSION}-linux-${node_arch}" && \
    node_tar_xz="/tmp/${node_dist}.tar.xz" && \
    node_tar="/tmp/${node_dist}.tar" && \
    curl -fsSLo "${node_tar_xz}" "https://nodejs.org/dist/v${NODE_VERSION}/${node_dist}.tar.xz" && \
    curl -fsSLo /tmp/node-shasums.txt "https://nodejs.org/dist/v${NODE_VERSION}/SHASUMS256.txt" && \
    (cd /tmp && grep " ${node_dist}.tar.xz$" /tmp/node-shasums.txt | sha256sum -c -) && \
    python3 -c 'import lzma, pathlib, shutil, sys; src = pathlib.Path(sys.argv[1]); dst = pathlib.Path(sys.argv[2]); reader = lzma.open(src, "rb"); writer = dst.open("wb"); shutil.copyfileobj(reader, writer); writer.close(); reader.close()' "${node_tar_xz}" "${node_tar}" && \
    tar -xf "${node_tar}" -C /usr/local --strip-components=1 --no-same-owner && \
    rm -f "${node_tar_xz}" "${node_tar}" /tmp/node-shasums.txt && \
    node --version | grep -Fx "v${NODE_VERSION}" && \
    npm --version >/dev/null && \
    npx --version >/dev/null

RUN python3 -m venv /opt/mcp-core-venv && \
    /opt/mcp-core-venv/bin/pip install --no-cache-dir --upgrade pip setuptools wheel && \
    /opt/mcp-core-venv/bin/pip install --no-cache-dir \
      "mcp-server-fetch==${MCP_FETCH_VERSION}" \
      "mcp-server-git==${MCP_GIT_VERSION}" \
      "mcp-server-time==${MCP_TIME_VERSION}" \
      "semgrep==${SEMGREP_VERSION}" && \
    /opt/mcp-core-venv/bin/mcp-server-fetch --help >/dev/null && \
    /opt/mcp-core-venv/bin/mcp-server-git --help >/dev/null && \
    /opt/mcp-core-venv/bin/mcp-server-time --help >/dev/null && \
    /opt/mcp-core-venv/bin/semgrep --version | grep -F "${SEMGREP_VERSION}"

RUN python3 -m venv /opt/mcp-markdown-venv && \
    /opt/mcp-markdown-venv/bin/pip install --no-cache-dir --upgrade pip setuptools wheel && \
    /opt/mcp-markdown-venv/bin/pip install --no-cache-dir \
      "markitdown-mcp==${MARKITDOWN_MCP_VERSION}" && \
    /opt/mcp-markdown-venv/bin/markitdown-mcp --help >/dev/null

RUN set -euo pipefail; \
    ln -sf /opt/mcp-core-venv/bin/mcp-server-fetch /usr/local/bin/mcp-server-fetch; \
    ln -sf /opt/mcp-core-venv/bin/mcp-server-git /usr/local/bin/mcp-server-git; \
    ln -sf /opt/mcp-core-venv/bin/mcp-server-time /usr/local/bin/mcp-server-time; \
    ln -sf /opt/mcp-core-venv/bin/semgrep /usr/local/bin/semgrep; \
    ln -sf /opt/mcp-markdown-venv/bin/markitdown-mcp /usr/local/bin/markitdown-mcp; \
    [ -x /usr/local/bin/mcp-server-fetch ]; \
    [ -x /usr/local/bin/mcp-server-git ]; \
    [ -x /usr/local/bin/mcp-server-time ]; \
    [ -x /usr/local/bin/semgrep ]; \
    [ -x /usr/local/bin/markitdown-mcp ]

RUN mkdir -p /opt/mcp-node && \
    FILESYSTEM_SERVER_VERSION="${FILESYSTEM_SERVER_VERSION}" \
    MEMORY_SERVER_VERSION="${MEMORY_SERVER_VERSION}" \
    SEQUENTIAL_THINKING_SERVER_VERSION="${SEQUENTIAL_THINKING_SERVER_VERSION}" \
    CONTEXT7_SERVER_VERSION="${CONTEXT7_SERVER_VERSION}" \
    PLAYWRIGHT_MCP_VERSION="${PLAYWRIGHT_MCP_VERSION}" \
    PLAYWRIGHT_VERSION="${PLAYWRIGHT_VERSION}" \
    CHROME_DEVTOOLS_MCP_VERSION="${CHROME_DEVTOOLS_MCP_VERSION}" \
    DBHUB_VERSION="${DBHUB_VERSION}" \
    GLOB_VERSION="${GLOB_VERSION}" \
    python3 -c 'import json, os; from pathlib import Path; pkg = {"name": "codex-mcp-runtime", "private": True, "dependencies": {"@modelcontextprotocol/server-filesystem": os.environ["FILESYSTEM_SERVER_VERSION"], "@modelcontextprotocol/server-memory": os.environ["MEMORY_SERVER_VERSION"], "@modelcontextprotocol/server-sequential-thinking": os.environ["SEQUENTIAL_THINKING_SERVER_VERSION"], "@upstash/context7-mcp": os.environ["CONTEXT7_SERVER_VERSION"], "@playwright/mcp": os.environ["PLAYWRIGHT_MCP_VERSION"], "playwright": os.environ["PLAYWRIGHT_VERSION"], "chrome-devtools-mcp": os.environ["CHROME_DEVTOOLS_MCP_VERSION"], "@bytebase/dbhub": os.environ["DBHUB_VERSION"]}, "overrides": {"glob": os.environ["GLOB_VERSION"]}}; Path("/opt/mcp-node/package.json").write_text(json.dumps(pkg, indent=2) + "\n", encoding="utf-8")' && \
    python3 -m json.tool /opt/mcp-node/package.json >/dev/null

RUN cd /opt/mcp-node && \
    npm install --omit=dev --no-audit --no-fund && \
    npm cache clean --force

RUN set -euo pipefail; \
    ln -sf /opt/mcp-node/node_modules/.bin/mcp-server-filesystem /usr/local/bin/mcp-filesystem; \
    ln -sf /opt/mcp-node/node_modules/.bin/mcp-server-memory /usr/local/bin/mcp-memory; \
    ln -sf /opt/mcp-node/node_modules/.bin/mcp-server-sequential-thinking /usr/local/bin/mcp-sequential-thinking; \
    ln -sf /opt/mcp-node/node_modules/.bin/context7-mcp /usr/local/bin/mcp-context7; \
    ln -sf /opt/mcp-node/node_modules/.bin/playwright /usr/local/bin/playwright; \
    ln -sf /opt/mcp-node/node_modules/.bin/playwright-mcp /usr/local/bin/mcp-playwright; \
    ln -sf /opt/mcp-node/node_modules/.bin/chrome-devtools-mcp /usr/local/bin/mcp-chrome-devtools; \
    ln -sf /opt/mcp-node/node_modules/.bin/dbhub /usr/local/bin/mcp-dbhub; \
    [ -x /usr/local/bin/mcp-filesystem ]; \
    [ -x /usr/local/bin/mcp-memory ]; \
    [ -x /usr/local/bin/mcp-sequential-thinking ]; \
    [ -x /usr/local/bin/mcp-context7 ]; \
    [ -x /usr/local/bin/playwright ]; \
    [ -x /usr/local/bin/mcp-playwright ]; \
    [ -x /usr/local/bin/mcp-chrome-devtools ]; \
    [ -x /usr/local/bin/mcp-dbhub ]

RUN arch="$(dpkg --print-architecture)" && \
    case "${arch}" in \
      amd64) cft_platform=linux64 ;; \
      *) cft_platform="" ;; \
    esac && \
    if [ -n "${cft_platform}" ]; then \
      curl -fsSLo /tmp/chrome-for-testing.zip \
        "https://storage.googleapis.com/chrome-for-testing-public/${CHROME_FOR_TESTING_VERSION}/${cft_platform}/chrome-${cft_platform}.zip" && \
      unzip -tq /tmp/chrome-for-testing.zip && \
      mkdir -p /opt/chrome && \
      unzip -q /tmp/chrome-for-testing.zip -d /opt/chrome && \
      rm -f /tmp/chrome-for-testing.zip && \
      ln -sfn /opt/chrome/chrome-linux64/chrome /usr/local/bin/chrome-for-mcp; \
    else \
      ln -sfn /usr/bin/chromium /usr/local/bin/chrome-for-mcp; \
    fi

RUN PLAYWRIGHT_BROWSERS_PATH="${PLAYWRIGHT_BROWSERS_PATH}" \
      /usr/local/bin/playwright install --with-deps chromium

RUN set -euo pipefail; \
    assert_stdio_server_start() { \
      local rc=0; \
      timeout 2s "$@" </dev/null >/dev/null 2>&1 || rc=$?; \
      [ "${rc}" -eq 0 ] || [ "${rc}" -eq 124 ]; \
    }; \
    node -e 'const pkg=require("/opt/mcp-node/node_modules/glob/package.json"); if (pkg.version !== process.argv[1]) process.exit(1)' "${GLOB_VERSION}"; \
    mcp-context7 --version | grep -Fx "${CONTEXT7_SERVER_VERSION}"; \
    mcp-playwright --version | grep -F "Version ${PLAYWRIGHT_MCP_VERSION}"; \
    /usr/local/bin/playwright --version | grep -F "Version ${PLAYWRIGHT_VERSION}"; \
    mcp-chrome-devtools --version 2>/dev/null | tail -n 1 | grep -Fx "${CHROME_DEVTOOLS_MCP_VERSION}"; \
    mcp-server-fetch --help >/dev/null; \
    mcp-server-git --help >/dev/null; \
    markitdown-mcp --help >/dev/null; \
    mcp-server-time --help >/dev/null; \
    semgrep mcp --help >/dev/null; \
    assert_stdio_server_start mcp-filesystem /tmp; \
    MEMORY_FILE_PATH=/tmp/memory-selftest.jsonl assert_stdio_server_start mcp-memory; \
    assert_stdio_server_start mcp-sequential-thinking; \
    assert_stdio_server_start mcp-dbhub --transport stdio --dsn "sqlite:///tmp/dbhub-selftest.db"

RUN mkdir -p \
      /cache/context7 \
      /cache/memory \
      /cache/markdown \
      /cache/npm \
      /cache/pip \
      /cache/playwright/browsers \
      /cache/playwright/output \
      /cache/python/pycache \
      /cache/semgrep \
      /cache/xdg/cache \
      /cache/xdg/config \
      /cache/xdg/state \
      /root/.local \
      /workspace/.mcp/sqlite && \
    rm -rf /root/.cache /root/.config /root/.local/state && \
    ln -sfn /cache/xdg/cache /root/.cache && \
    ln -sfn /cache/xdg/config /root/.config && \
    ln -sfn /cache/xdg/state /root/.local/state && \
    chown -R 0:0 /cache /workspace && \
    chmod 0777 \
      /cache \
      /cache/context7 \
      /cache/memory \
      /cache/markdown \
      /cache/npm \
      /cache/pip \
      /cache/playwright \
      /cache/playwright/browsers \
      /cache/playwright/output \
      /cache/python \
      /cache/python/pycache \
      /cache/semgrep \
      /cache/xdg \
      /cache/xdg/cache \
      /cache/xdg/config \
      /cache/xdg/state \
      /root/.local \
      /workspace \
      /workspace/.mcp \
      /workspace/.mcp/sqlite

RUN cat > /usr/local/bin/mcp-server <<'EOF'
#!/bin/bash
set -euo pipefail

server="${1:-help}"
if [ "$#" -gt 0 ]; then
  shift
fi

print_help() {
  cat <<'HELP'
Usage:
  mcp-server <server> [server args...]

Servers:
  filesystem           Official filesystem reference server
  git                  Official git reference server
  fetch                Official fetch reference server
  memory               Official persistent memory reference server
  sequential-thinking  Official sequential thinking reference server
  time                 Official time reference server
  markdown             MarkItDown MCP conversion server
  context7             Upstash Context7 MCP server
  playwright           Microsoft Playwright MCP server
  chrome-devtools      Google Chrome DevTools MCP server
  postgres             Bytebase DBHub entrypoint for PostgreSQL DSNs
  sqlite               Bytebase DBHub entrypoint for SQLite DSNs
  semgrep              `semgrep mcp`
HELP
}

case "${server}" in
  filesystem)
    if [ "$#" -eq 0 ]; then
      set -- "${FILESYSTEM_ROOT:-/workspace}"
    fi
    exec mcp-filesystem "$@"
    ;;
  git)
    if [ "$#" -eq 0 ]; then
      set -- --repository "${MCP_GIT_REPOSITORY:-${GIT_REPOSITORY:-/workspace}}"
    fi
    exec mcp-server-git "$@"
    ;;
  fetch)
    fetch_args=()
    if [ -n "${FETCH_USER_AGENT:-}" ]; then
      fetch_args+=(--user-agent "${FETCH_USER_AGENT}")
    fi
    if [ "${FETCH_IGNORE_ROBOTS_TXT:-0}" = "1" ]; then
      fetch_args+=(--ignore-robots-txt)
    fi
    if [ -n "${FETCH_PROXY_URL:-}" ]; then
      fetch_args+=(--proxy-url "${FETCH_PROXY_URL}")
    fi
    exec mcp-server-fetch "${fetch_args[@]}" "$@"
    ;;
  memory)
    mkdir -p "$(dirname "${MEMORY_FILE_PATH}")"
    if [ ! -e "${MEMORY_FILE_PATH}" ]; then
      : > "${MEMORY_FILE_PATH}"
    fi
    exec mcp-memory "$@"
    ;;
  sequential-thinking|sequentialthinking)
    exec mcp-sequential-thinking "$@"
    ;;
  time)
    if [ "$#" -eq 0 ] && [ -n "${LOCAL_TIMEZONE:-}" ]; then
      set -- --local-timezone "${LOCAL_TIMEZONE}"
    fi
    exec mcp-server-time "$@"
    ;;
  markdown|markitdown)
    exec markitdown-mcp "$@"
    ;;
  context7)
    if [ "$#" -eq 0 ]; then
      set -- --transport stdio
      if [ -n "${CONTEXT7_API_KEY:-}" ]; then
        set -- "$@" --api-key "${CONTEXT7_API_KEY}"
      fi
    fi
    exec mcp-context7 "$@"
    ;;
  playwright)
    exec mcp-playwright \
      --headless \
      --isolated \
      --no-sandbox \
      --output-dir /cache/playwright/output \
      "$@"
    ;;
  chrome-devtools|chromedevtools|devtools)
    exec mcp-chrome-devtools \
      --headless \
      --isolated \
      --no-usage-statistics \
      --no-performance-crux \
      --executable-path "${CHROME_PATH}" \
      --chrome-arg=--no-sandbox \
      --chrome-arg=--disable-dev-shm-usage \
      "$@"
    ;;
  postgres)
    if [ "$#" -eq 0 ]; then
      if [ -n "${DBHUB_CONFIG:-}" ]; then
        set -- --transport stdio --config "${DBHUB_CONFIG}"
      else
        dsn="${POSTGRES_DSN:-${DATABASE_URL:-${DSN:-}}}"
        if [ -z "${dsn}" ]; then
          echo "postgres requires POSTGRES_DSN, DATABASE_URL, DSN, or DBHUB_CONFIG." >&2
          exit 64
        fi
        set -- --transport stdio --dsn "${dsn}"
      fi
    fi
    exec mcp-dbhub "$@"
    ;;
  sqlite)
    if [ "$#" -eq 0 ]; then
      if [ -n "${DBHUB_CONFIG:-}" ]; then
        set -- --transport stdio --config "${DBHUB_CONFIG}"
      else
        mkdir -p /workspace/.mcp/sqlite
        dsn="${SQLITE_DSN:-${DSN:-sqlite:///workspace/.mcp/sqlite/default.db}}"
        set -- --transport stdio --dsn "${dsn}"
      fi
    fi
    exec mcp-dbhub "$@"
    ;;
  semgrep)
    exec semgrep mcp "$@"
    ;;
  help|--help|-h|"")
    print_help
    ;;
  *)
    echo "Unknown MCP server: ${server}" >&2
    print_help >&2
    exit 64
    ;;
esac
EOF

RUN chmod 0755 /usr/local/bin/mcp-server && \
    /usr/local/bin/mcp-server help >/dev/null

WORKDIR /workspace

ENTRYPOINT ["/usr/bin/tini", "--", "/usr/local/bin/mcp-server"]
CMD ["help"]
