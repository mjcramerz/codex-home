# Declarative data, NOT a shell script. Never source this file or put API values here.
# The parser rejects unknown/duplicate keys, substitutions, control characters,
# unsafe paths, unsupported accounts, and unpinned image references.
PODMAN_USER=devops
PODMAN_HOME=/data/accounts/devops
PODMAN_SOCKET=/data/accounts/devops/run/podman.sock
PODMAN_BINARY=/usr/bin/podman
DESKTOP_USER=auto
# auto means the selected desktop account's real $HOME/Workspace, not devops HOME.
WORKSPACE=auto
MCP_SOCKET=/data/accounts/devops/run/codex-mcp.sock
MCP_STATE_ROOT=/pool/podman/mcp
# auto resolves to /run/user/<devops UID>/codex-mcp; never persist staged secrets.
MCP_RUNTIME_ROOT=auto
MCP_CONFIG_DIR=/etc/codex/mcp
MCP_INSTALL_ROOT=/usr/local/libexec/codex-mcp
MCP_TRANSPORT=unix

# Supplied image, immutable manifest, and expected OCI configuration digest.
MCP_BASE_IMAGE=registry.gitlab.com/registry-containers/mcp-images/mcp@sha256:c3f792dfd37e741be259cac10f80197e797633f4620f1ff5538a1798ab791f19
MCP_BASE_CONFIG_DIGEST=sha256:5eb775eace3c5c4a2759f6dccc704c71fa135239fc00d18a4c65b147ffb38980
# Minimum fixed release for GHSA-mwwr-p57h-56pf; never use the supplied 0.22.3.
DBHUB_PATCH_VERSION=0.22.6
MCP_DERIVED_IMAGE=localhost/codex-mcp:2026-09-06
CONTAINER_UID=1000
CONTAINER_GID=1000

# Session containers run on demand; there is no shared stdin and no TCP MCP port.
MAX_SESSIONS=32
MAX_SESSIONS_PER_SERVER=4
# Reference memory writes are not multi-process safe. Memory and SQLite each
# take an exclusive lifetime lock; a second client gets a clear busy response.
HEADER_TIMEOUT_SECONDS=10
CONNECT_TIMEOUT_SECONDS=15
IDLE_TIMEOUT_SECONDS=1800
SESSION_MAX_SECONDS=28800
STOP_TIMEOUT_SECONDS=10
STARTUP_TIMEOUT_SECONDS=90
TOOL_TIMEOUT_SECONDS=180
MAX_BUFFER_BYTES=1048576
MAX_STDERR_BYTES=32768
# Server stderr is not journaled by default: some upstream errors contain DSNs.
CAPTURE_SERVER_STDERR=false
MIN_FREE_MIB=512

# Defaults per container; browser modes have a separate memory/PID allowance.
CONTAINER_CPUS=2
CONTAINER_MEMORY=1g
CONTAINER_PIDS=256
BROWSER_CPUS=2
BROWSER_MEMORY=2g
BROWSER_PIDS=512
TMPFS_SIZE=256m
BROWSER_SHM_SIZE=256m
# Named rootless bridge; no --network=host, port publishing, engine socket mount,
# --privileged, :U recursive ownership changes, or seccomp=unconfined.
MCP_NETWORK=codex-mcp-egress
NETWORK_SUBNET=10.89.77.0/24
LOCAL_TIMEZONE=Europe/Stockholm
BROWSER_NO_SANDBOX=false
# Browser-only namespace allowances are derived from this protected deny-default profile.
BROWSER_SECCOMP_BASE=/usr/share/containers/seccomp.json

# All installed tool directories discovered from the supplied profile are mapped
# read-only. Tool caches/config/history are isolated per session, not copied from
# desktop credentials. The coverage report records absent and ABI-sensitive tools.
TOOLCHAIN_ENABLED=true
TOOLCHAIN_PROFILE=/etc/skel/.profile.d/71-devops-de.sh
TOOLCHAIN_REQUIRE_ALL=false
HOST_NODE=/usr/local/lib/node-26/bin/node
# ACL changes affect Workspace only, plus traversal/read access to selected tools.
WORKSPACE_EXISTING_ACL=true
TOOLCHAIN_READ_ACL=true

# SSH is an OPTIONAL, separate loopback-only transport. The normal host sshd and
# its DenyUsers devops policy are untouched. Login is the desktop identity; the
# forced gateway reaches the devops broker. Keys are generated on the target.
SSH_ENABLED=true
SSH_PORT=2229
SSH_CONNECT_TIMEOUT_SECONDS=10
# Native desktop sessions may select ssh. The supplied Bubblewrap wrapper has
# isolated loopback: it must use unix (the socket lives on its visible /data mount).

# Credentials are root-owned files under MCP_CONFIG_DIR/credentials, projected
# with systemd LoadCredential, then staged per server for the remote engine.
# To provision: sudo codex-mcp-admin credential --name postgres-dsn --file /secure/file
# Known IDs: context7-api-key, postgres-dsn, semgrep-app-token, openai-api-key,
# azure-openai-api-key, azure-openai-endpoint, azure-openai-api-version,
# fetch-proxy-url, github-token. Empty optional files are not mounted.
POSTGRES_READONLY=true
POSTGRES_REQUIRE_TLS=true
SQLITE_READONLY=false
FETCH_IGNORE_ROBOTS_TXT=false
FETCH_USER_AGENT=Codex-MCP/2026-09-06
# Git uses a temporary askpass helper only when github-token was provisioned.
# Empty means discover repositories through tools; no assumption Workspace is a repo.
GIT_REPOSITORY=
