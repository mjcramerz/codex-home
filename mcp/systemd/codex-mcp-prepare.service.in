[Unit]
Description=Prepare private Codex MCP runtime and persistent state
Requires=podman-devops-bootstrap.service
After=podman-devops-bootstrap.service
RequiresMountsFor=/run/podman-devops /pool/podman /data/codex/sockets
PartOf=codex-mcp.target

[Service]
Type=oneshot
ExecStart=@CURRENT@/bin/codex-mcp-admin prepare
RemainAfterExit=yes
UMask=0077
