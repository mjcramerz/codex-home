[Unit]
Description=Isolated Codex MCP stdio session %i
After=codex-mcp-prepare.service
PartOf=codex-mcp.target

[Service]
Type=exec
User=devops
Group=devops
UMask=0077
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=HOME=/data/accounts/devops
Environment=XDG_RUNTIME_DIR=/run/user/@DEVOPS_UID@
ExecStart=@CURRENT@/bin/broker serve %i
ExecStopPost=@CURRENT@/bin/broker gc %i
StandardInput=socket
StandardOutput=socket
StandardError=journal
SyslogIdentifier=codex-mcp
@LOAD_CREDENTIALS@
TimeoutStopSec=75s
RuntimeMaxSec=@SYSTEMD_SESSION_MAX@s
KillMode=control-group
KillSignal=SIGTERM
SendSIGKILL=yes
Restart=no
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=@MCP_RUNTIME_ROOT@
InaccessiblePaths=-/etc/codex/mcp/credentials
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
RestrictSUIDSGID=yes
RestrictRealtime=yes
RestrictNamespaces=yes
RestrictAddressFamilies=AF_UNIX
LockPersonality=yes
MemoryDenyWriteExecute=yes
CapabilityBoundingSet=
AmbientCapabilities=
LimitNOFILE=1024
TasksMax=128
MemoryMax=192M
CPUQuota=100%
