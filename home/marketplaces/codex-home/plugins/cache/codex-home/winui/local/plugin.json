{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
  "name": "winui",
  "version": "1.1.0",
  "description": "Use this plugin for microsoft WinUI and Windows App SDK desktop application workflows.",
  "author": {
    "name": "Microsoft"
  },
  "homepage": "https://learn.microsoft.com/windows/apps/winui/",
  "keywords": [
    "microsoft",
    "winui",
    "windows",
    "desktop",
    "xaml"
  ],
  "extensions": {
    "com.openai": {
      "interface": {
        "displayName": "WinUI",
        "shortDescription": "WinUI desktop applications",
        "category": "Developer Tools",
        "capabilities": [
          "Read",
          "Write"
        ],
        "defaultPrompt": [
          "Use the WinUI plugin for Microsoft WinUI and Windows App SDK workflows."
        ],
        "longDescription": "Use this plugin for WinUI 3, Windows App SDK, and Microsoft desktop application implementation workflows.",
        "developerName": "Microsoft",
        "brandColor": "#2563EB",
        "websiteURL": "https://learn.microsoft.com/windows/apps/winui/",
        "logo": "./skills/winui-app/assets/winui.png",
        "screenshots": []
      }
    }
  }
}
