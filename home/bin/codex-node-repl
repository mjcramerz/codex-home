#!/usr/bin/python3
"""Launch the installed desktop Node REPL without inventing an MCP implementation."""
from __future__ import annotations
import json, os, stat, sys
from pathlib import Path

def checked_executable(value: str, label: str) -> str:
    p = Path(value)
    if not p.is_absolute() or not p.is_file() or not os.access(p, os.X_OK):
        raise ValueError(label + " is absent or not executable: " + value)
    if p.stat().st_mode & stat.S_IWOTH:
        raise ValueError(label + " is world-writable")
    return str(p)

def main() -> int:
    if len(sys.argv) != 1:
        raise ValueError("node-repl launcher takes no arguments")
    launcher = checked_executable(os.environ.get("NODE_REPL_LAUNCHER", "/usr/lib/chatgpt/resources/cua_node/bin/node_repl"), "Desktop REPL")
    checked_executable(os.environ.get("NODE_REPL_NODE_PATH", ""), "REPL Node")
    checked_executable(os.environ.get("CODEX_CLI_PATH", ""), "Desktop Codex")
    services = json.loads(os.environ.get("NODE_REPL_TRUSTED_SERVICES", "{}"))
    if not isinstance(services, dict):
        raise ValueError("NODE_REPL_TRUSTED_SERVICES must be a map")
    for name, value in services.items():
        if not isinstance(value, str) or not Path(value).is_absolute() or not Path(value).is_file():
            raise ValueError("Missing trusted desktop service: " + str(name))
    # Deliberately no PATH scanning, shell evaluation, package download or fallback.
    os.execve(launcher, [launcher], dict(os.environ))
    return 127

if __name__ == "__main__":
    try:
        raise SystemExit(main())
    except (OSError, ValueError) as exc:
        print("codex-node-repl: " + str(exc), file=sys.stderr)
        raise SystemExit(78)
