{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/python3 -I \"$CODEX_HOME/.hooks/runner.py\" --event SessionStart --timeout 3",
            "timeout": 5,
            "statusMessage": "Discover repository entrypoints",
            "additionalContextLimit": 2000
          }
        ],
        "matcher": "^(startup|resume|clear|compact|fork)$"
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/python3 -I \"$CODEX_HOME/.hooks/runner.py\" --event SessionEnd --timeout 1",
            "timeout": 2,
            "statusMessage": "Clear private hook state"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/python3 -I \"$CODEX_HOME/.hooks/runner.py\" --event UserPromptSubmit --timeout 3",
            "timeout": 5,
            "statusMessage": "Refresh task-specific repository guidance",
            "additionalContextLimit": 2000
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/python3 -I \"$CODEX_HOME/.hooks/runner.py\" --event PreToolUse --timeout 3",
            "timeout": 5,
            "statusMessage": "Check tool execution boundaries",
            "additionalContextLimit": 600
          }
        ],
        "matcher": ".*"
      }
    ],
    "PermissionRequest": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/python3 -I \"$CODEX_HOME/.hooks/runner.py\" --event PermissionRequest --timeout 3",
            "timeout": 5,
            "statusMessage": "Preserve native approval decisions"
          }
        ],
        "matcher": ".*"
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/python3 -I \"$CODEX_HOME/.hooks/runner.py\" --event PostToolUse --timeout 3",
            "timeout": 5,
            "statusMessage": "Observe tool status and changed contracts",
            "additionalContextLimit": 600
          }
        ],
        "matcher": ".*"
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/python3 -I \"$CODEX_HOME/.hooks/runner.py\" --event PreCompact --timeout 3",
            "timeout": 5,
            "statusMessage": "Preserve verification and handoff context"
          }
        ]
      }
    ],
    "PostCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/python3 -I \"$CODEX_HOME/.hooks/runner.py\" --event PostCompact --timeout 3",
            "timeout": 5,
            "statusMessage": "Refresh context after compaction"
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/python3 -I \"$CODEX_HOME/.hooks/runner.py\" --event SubagentStart --timeout 3",
            "timeout": 5,
            "statusMessage": "Scope the delegated task",
            "additionalContextLimit": 2000
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/python3 -I \"$CODEX_HOME/.hooks/runner.py\" --event SubagentStop --timeout 3",
            "timeout": 5,
            "statusMessage": "Review delegated evidence"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/python3 -I \"$CODEX_HOME/.hooks/runner.py\" --event Stop --timeout 3",
            "timeout": 5,
            "statusMessage": "Account for edits and failed checks"
          }
        ]
      }
    ],
    "Interrupt": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/python3 -I \"$CODEX_HOME/.hooks/runner.py\" --event Interrupt --timeout 1",
            "timeout": 2,
            "statusMessage": "Refresh context after interruption"
          }
        ]
      }
    ]
  }
}
