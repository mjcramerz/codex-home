{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
  "name": "adobe-acrobat",
  "version": "1.1.0",
  "description": "Use this plugin for adobe Acrobat workflows for PDF reading, forms, signing, reviews, and document handoffs.",
  "author": {
    "name": "Adobe"
  },
  "homepage": "https://www.adobe.com/acrobat.html",
  "keywords": [
    "acrobat",
    "adobe",
    "pdf",
    "forms",
    "signing",
    "review",
    "documents"
  ],
  "extensions": {
    "com.openai": {
      "apps": "./.app.json",
      "interface": {
        "displayName": "Adobe Acrobat",
        "shortDescription": "PDF forms, signing, and review",
        "category": "Productivity",
        "capabilities": [
          "Interactive",
          "Read",
          "Write"
        ],
        "defaultPrompt": [
          "Use the Adobe Acrobat plugin to review, organize, annotate, fill, sign, compare, and route PDFs with explicit handoffs."
        ],
        "longDescription": "Use this plugin for Adobe Acrobat reading, annotation, forms, signing, compare, and review workflows with clear handoffs to local document tooling.",
        "developerName": "Adobe",
        "brandColor": "#FA0F00",
        "websiteURL": "https://www.adobe.com/acrobat.html",
        "privacyPolicyURL": "https://www.adobe.com/privacy/policy.html",
        "termsOfServiceURL": "https://www.adobe.com/legal/terms.html",
        "composerIcon": "./skills/acrobat-reader/assets/app-icon.png",
        "logo": "./skills/acrobat-reader/assets/app-icon.png",
        "screenshots": []
      }
    }
  }
}
